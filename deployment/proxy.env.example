# Copy to deployment/proxy.env (git-ignored). deploy.sh uploads it to the server.

# Upstreams, as name=https://base-url. Requests to /<name>/... go to that upstream.
ROUTES=openai=https://api.openai.com

# Upstream API keys, never sent to clients. NAME is the route name upper-cased.
UPSTREAM_OPENAI_KEY=
# Header the key goes in. Default: Authorization: Bearer <key>.
# UPSTREAM_OPENAI_HEADER=x-api-key

# Optional (defaults shown)
# MAX_BODY_BYTES=10485760
# UPSTREAM_TIMEOUT=60s
